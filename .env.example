# Porta da API (local)
PORT=4000

# Ambiente: development | production
NODE_ENV=production

# SEGREDO obrigatório em produção.
# Gere um valor forte: openssl rand -hex 48
# Nunca commite este arquivo.
JWT_SECRET=sua-chave-secreta-aqui-de-al menos-48-caracteres

# Banco de dados das contas (Supabase).
# As RPCs app_register/app_login/app_me/app_logout são SECURITY DEFINER,
# então basta a chave pública (publishable) — nunca use a service role aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
