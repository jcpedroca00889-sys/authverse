# Porta da API (local)
PORT=4000

# Ambiente: development | production
NODE_ENV=production

# SEGREDO obrigatório em produção.
# Gere um valor forte: openssl rand -hex 48
# Nunca commite este arquivo.
JWT_SECRET=sua-chave-secreta-aqui-de-al-menos-48-caracteres

# Banco de dados das contas (Supabase).
# As RPCs app_register/app_login/app_me/app_logout são SECURITY DEFINER,
# então basta a chave pública (publishable) — nunca use a service role aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Usernames de administradores (separados por vírgula).
# Ex: ADMIN_USERNAMES=admin,superadmin,gerente
# O primeiro admin deve ser criado manualmente no banco ou via registro,
# depois adicionado aqui para ganhar permissão de admin.
ADMIN_USERNAMES=admin